# OpenRouter credential.
#
# Optional: if omp already has an OpenRouter login (`/login openrouter`),
# omp-router reads it straight from omp's auth store at
# ~/.omp/agent/agent.db and needs nothing here. Set this only to override
# that, or to point at a different account.
#
# The model catalog is readable unauthenticated either way, so
# `omp-router models` and `omp-router config --print` work with no key at all.
OPENROUTER_API_KEY=

# When the router is embedded in omp (router-embed.ts), it binds a free
# OS-assigned port so multiple omp sessions never collide. Set OMP_ROUTER_PORT
# to pin a specific port instead (rarely needed). For the standalone `serve`
# command, OMP_ROUTER_HOST/OMP_ROUTER_PORT override its bind (default 127.0.0.1:8788).
# OMP_ROUTER_HOST=127.0.0.1
# OMP_ROUTER_PORT=8788

# Listen address overrides. Default: 127.0.0.1:8787
# OMP_ROUTER_HOST=127.0.0.1
# OMP_ROUTER_PORT=8787

# Log level: silent | error | warn | info | debug. Default: info
# OMP_ROUTER_LOG=info

# SQLite ledger path. Default: $OMP_ROUTER_HOME/router.db
# OMP_ROUTER_DB=
