# Required for completions. The OpenRouter model catalog is readable without it,
# so `omp-router models` and `omp-router config` work unauthenticated.
OPENROUTER_API_KEY=

# Config and database directory. Default: ~/.omp-router
# OMP_ROUTER_HOME=

# Listen address overrides. Default: 127.0.0.1:8787
# OMP_ROUTER_HOST=127.0.0.1
# OMP_ROUTER_PORT=8787

# Log level: silent | error | warn | info | debug. Default: info
# OMP_ROUTER_LOG=info

# SQLite ledger path. Default: $OMP_ROUTER_HOME/router.db
# OMP_ROUTER_DB=
