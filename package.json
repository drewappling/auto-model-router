{
  "name": "auto-model-router",
  "version": "0.2.22",
  "private": false,
  "description": "Local cost/complexity-aware model router for Oh My Pi, backed by OpenRouter",
  "type": "module",
  "bin": {
    "auto-model-router": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run tools/smoke.ts",
    "version": "bun run tools/sync-marketplace-version.ts",
    "release": "npm version $1 && git push --follow-tags"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drewappling/auto-model-router.git"
  },
  "homepage": "https://github.com/drewappling/auto-model-router",
  "bugs": {
    "url": "https://github.com/drewappling/auto-model-router/issues"
  },
  "omp": {
    "extensions": [
      "./omp-extension/router-embed.ts",
      "./omp-extension/router-toast.ts",
      "./omp-extension/router-configure.ts"
    ]
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./omp-extension/router-embed.ts",
      "./omp-extension/router-toast.ts",
      "./omp-extension/router-configure.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
