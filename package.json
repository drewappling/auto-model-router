{
  "name": "omp-router",
  "version": "0.1.0",
  "private": false,
  "description": "Local cost/complexity-aware model router for Oh My Pi, backed by OpenRouter",
  "type": "module",
  "bin": {
    "omp-router": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run tools/smoke.ts"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drewappling/omp-autorouter.git"
  },
  "homepage": "https://github.com/drewappling/omp-autorouter",
  "bugs": {
    "url": "https://github.com/drewappling/omp-autorouter/issues"
  },
  "omp": {
    "extensions": [
      "./omp-extension/router-embed.ts",
      "./omp-extension/router-toast.ts",
      "./omp-extension/router-configure.ts"
    ]
  }
}
